<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId is com.github.LiQiyeDev, exactly as in botmaker-shared and botmaker-session and for the same
      reason: JitPack serves this repo as com.github.LiQiyeDev:botmaker-studio-api:<tag> regardless of what
      this pom says, so matching it here makes the reactor GAV identical to the published GAV. The version
      below is cosmetic — JitPack overrides it with the git tag.
    -->
    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-studio-api</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <name>BotMaker Studio Plugin API</name>
    <description>
        The contract a BotMaker Studio plugin compiles against: what it contributes to the palette, and how
        it edits a value slot. Interfaces and records only — no implementation, no Studio types.
    </description>

    <!--
      This module deliberately does NOT run flatten-maven-plugin, unlike botmaker-session and botmaker-sdk.
      Flatten is there to bake a -D-injected ${botmaker.*.version} into the published pom; this module has no
      property-driven dependency to bake. Its one dependency is javafx-controls at a literal version, in
      `provided` scope, so the committed pom is already the pom a consumer needs.

      It also has no .deps.env for the same reason: it pins no BotMaker upstream, so there is nothing for a
      release to record and nothing for jitpack.yml to source.
    -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JavaFX 25 LTS, pinned to its newest patch rather than the bare GA. It is the version the
             whole platform shares: the contract, the toolkit, the CLI (compile-only) and Studio all
             read this number, and javafx-controls is compiled against one exact javafx-graphics. -->
        <javafx.version>25.0.4</javafx.version>
        <junit.version>5.10.2</junit.version>
        <!-- The published tag japicmp compares this build against. Bumped automatically now, by
             release.sh's bump_japicmp_baseline, in each release commit — it was `v1.0.0` until 2026-09-02,
             a placeholder for the first release this module had not had yet, and the instruction to move
             it by hand "in every release commit from the first one onward" was never once carried out. A
             baseline naming a tag that does not exist is not a strict gate: ignoreMissingOldVersion (which
             is there so a first release is not refused for a reason its author cannot act on) makes it
             report and pass. Worse, `v1.0.0` sorts ABOVE every tag this module will have for a long time,
             so the automation's never-move-backwards rule would have frozen it there.
             Offline builds that have never fetched the baseline pass -Dbotmaker.japicmp.skip=true, which
             also deactivates the api-gate profile below. -->
        <!-- v0.1.6, a tag that does not exist yet, and deliberately: the 2026-09-21 package move is a
             binary-incompatible change, so comparing this build against v0.1.5 can only refuse it.
             ignoreMissingOldVersion (below, and there since the first release for its own reasons) makes an
             absent baseline report and pass, so the gate stays loaded and keeps checking everything else
             until the tag exists; from the moment it does, this compares v0.1.6 against itself and passes;
             from v0.1.7 Japicmp.bump takes over again, which never moves the baseline backwards. The break
             itself is recorded in docs/refactor/25-compatibility.md and in CHANGELOG.md. -->
        <botmaker.japicmp.baseline>v0.1.6</botmaker.japicmp.baseline>
        <botmaker.japicmp.skip>false</botmaker.japicmp.skip>
    </properties>

    <dependencies>
        <!--
          A slot editor returns a javafx.scene.Node. That pins the plugin platform to JavaFX permanently and
          it is a decision, not an oversight: a UI-factory abstraction able to express the bespoke editors
          (image template, capture source, launch target) would be larger than JavaFX itself.

          `provided` is what keeps it off everyone else's classpath. Studio brings its own JavaFX; the SDK
          declares JavaFX optionally for the editors it ships; and a generated bot resolves neither, because
          a provided-scope dependency is never transitive.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- There is deliberately no Jackson here, and adding one is the thing to refuse.
         The authoring records in com.botmaker.plugin.api.authoring describe a wire form; they do not parse
         it. A JSON annotation on one of them needs jackson-annotations on this pom, and this pom is
         resolved by every plugin that ever compiles against the contract — so the library would be imposed
         on all of them to serve one reader. Whoever owns a file supplies its parser: the SDK binds these
         records in com.botmaker.sdk.internal.authoring.AuthoringMixins, from outside, with mix-ins.
         Nine days in August 2026 aside, the rule has held since the vocabulary opened. -->


    <build>
        <plugins>
            <!-- PIN THE COMPILER, and do not delete this as redundant: locally it IS redundant, and on
                 JitPack it is the difference between a published artifact and none.

                 Maven only defaults a plugin's version for the ones bound to the lifecycle, and the
                 default it picks comes from the Maven version doing the building. JitPack's is old enough
                 to default maven-compiler-plugin to 3.1 — which predates maven.compiler.release (added in
                 3.6) entirely, ignores the property above, and falls back to source/target 5:

                     [ERROR] Source option 5 is no longer supported. Use 8 or later.

                 This module stopped building on JitPack the day the platform moved to
                 maven.compiler.release (2026-09-02) and nothing downstream could resolve it: the toolkit,
                 plugin-host, the cli and the SDK all failed with "Could not find artifact
                 com.github.LiQiyeDev:botmaker-studio-api" for two days, because release.sh's JitPack check
                 reports rather than blocks and its warning reads exactly like a slow queue. Six of eight
                 published modules were unresolvable. See CLAUDE.md § Releasing, and releases/*.md, which
                 exists so the next one is noticed.

                 AND THE VERSION IS 3.11.0, NOT A NEWER ONE, which is the second half of the same trap.
                 v0.0.3 pinned 3.13.0 and failed on JitPack in a different way:

                     [ERROR] The plugin org.apache.maven.plugins:maven-compiler-plugin:3.13.0
                             requires Maven version 3.6.3

                 maven-compiler-plugin raised its own Maven prerequisite from 3.2.5 to 3.6.3 in 3.12.0, and
                 JitPack's Maven is older than that. 3.11.0 is the newest version that builds there, which
                 is why botmaker-shared — the one module that has never been broken — pins exactly it.
                 Match it; do not "modernise" this number. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!-- The API gate, in a profile so that a build which only wants the ARTIFACT can decline to load
             the plugin at all.

             ACTIVE BY DEFAULT: the activation is the ABSENCE of botmaker.japicmp.skip, and a property
             declared in <properties> above does not count for profile activation — only a -D does. So
             `mvn verify` here and in CI runs the gate exactly as before, and only an explicit
             `-Dbotmaker.japicmp.skip=true` turns it off. <skip> below stays for symmetry; with the profile
             inactive the plugin is never loaded, so it never evaluates.

             WHY THE PROFILE RATHER THAN THE <skip> FLAG: skipping is a decision the mojo makes after Maven
             has resolved and loaded the plugin, and this plugin declares a PREREQUISITE. JitPack's builder
             runs an older Maven, so the v0.0.1 build of this module — the first tag this module ever had —
             died before any configuration was read:

               [ERROR] Failed to execute goal com.github.siom79.japicmp:japicmp-maven-plugin:0.23.1:cmp
               (default) on project botmaker-studio-api: The plugin ... requires Maven version 3.6.3

             That published no artifact, which in turn took botmaker-sdk v1.1.1 down with it
             (`Could not find artifact com.github.LiQiyeDev:botmaker-studio-api:jar:v0.0.1`). A gate that
             can only refuse a tag ALREADY PUSHED protects nothing and can only break the publish; the
             refusal that matters happened in this repository's own `mvn verify` before the tag existed.
             That is the same reasoning as the `-DskipTests` jitpack.yml has always passed. -->
        <profile>
            <id>api-gate</id>
            <activation>
                <property>
                    <name>!botmaker.japicmp.skip</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- japicmp — the contract is binary-compatible with every plugin already compiled
                         against it.

                         A plugin's .class files cannot be rewritten by anyone, which is the whole reason
                         this module is separate from the SDK, and the trap 25-compatibility.md lists under
                         "not checked by anything" is the one this catches: adding a component to a public
                         record changes its canonical constructor descriptor and throws NoSuchMethodError in
                         every already-built plugin — source-compatible, binary-incompatible, and until now
                         carried by a Javadoc sentence.

                         Unconditional, which is what makes it legitimate where the SDK's August gate was
                         not: that one had to tell an intended break from an accident and could not see the
                         version. Here there is no legitimate break to distinguish — only a Studio major
                         release may make one, and that is the release that edits this block. So no ignore
                         list, no exemption annotation, no verdict file. No postAnalysisScript either: its
                         bundled Groovy cannot read Java 26 class files. -->
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>0.23.1</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>com.github.LiQiyeDev</groupId>
                                    <artifactId>botmaker-studio-api</artifactId>
                                    <version>${botmaker.japicmp.baseline}</version>
                                    <type>jar</type>
                                </dependency>
                            </oldVersion>
                            <parameter>
                                <onlyModified>true</onlyModified>
                                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                                <includes>
                                    <include>com.botmaker.plugin.api</include>
                                </includes>
                                <breakBuildBasedOnSemanticVersioning>false</breakBuildBasedOnSemanticVersioning>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <includeSynthetic>false</includeSynthetic>
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                            </parameter>
                            <skip>${botmaker.japicmp.skip}</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
